# Copiar pra /etc/opencall-metrics/config.env na VPS, com chmod 600 (root:root)
# — tem a chave da Vultr e o secret de ingest. Nunca commitar o arquivo real.

OPENCALL_INGEST_URL="https://SEU-DOMINIO-AQUI"
OPENCALL_METRICS_SECRET="mesmo valor de SERVER_METRICS_INGEST_SECRET no Railway"

VULTR_API_KEY="chave da Vultr, com o IP desta VPS na allowlist"
VULTR_INSTANCE_ID="id da instancia, visivel na URL do painel da Vultr"
