generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CANAL_ACCESS
  CHANNELS_ACCESS

  @@map("user_role")
}

enum ChannelType {
  VOICE
  TEXT

  @@map("channel_type")
}

/// Canal dinâmico (voz ou texto), criado/editado/excluído por um admin em
/// /admin/channels (ver RFC "Canais dinâmicos"). `geral`/`primos`/`global` são
/// seedados com o mesmo id que já usavam como constante de código — trocar o
/// id invalidaria salas do LiveKit e histórico de TextMessage/TextChannelRead
/// já existente (ver ADR-0001).
///
/// Sem soft-delete (ver ADR-0003, revisada): excluir um canal remove a linha
/// de verdade. TextMessage/TextChannelRead cascade junto; VoiceChannelAlert
/// (sem FK) é limpo manualmente na mesma transação da rota DELETE.
model Channel {
  id              String      @id @default(cuid())
  type            ChannelType
  name            String
  /// Só voice; null pra text (ver ADR-0001 — tabela única com discriminador).
  maxParticipants Int?        @map("max_participants")
  sortIndex       Int         @default(0) @map("sort_index")
  createdAt       DateTime    @default(now()) @map("created_at")
  createdById     String?     @map("created_by_id")

  textMessages     TextMessage[]
  textChannelReads TextChannelRead[]

  @@index([type, sortIndex])
  @@map("channels")
}

model User {
  id        String     @id // = discordId
  username  String
  avatar    String
  email     String?
  verified  Boolean    @default(false)
  roles     UserRole[] @default([])
  createdAt DateTime   @default(now()) @map("created_at")

  /// Bloqueio de envio em qualquer canal de texto, aplicado por um
  /// channels_admin (ver POST /api/chat/block) — é global ao usuário, não
  /// por canal.
  chatBlocked Boolean @default(false) @map("chat_blocked")

  /// true depois que o usuário marca "Não mostrar novamente" no popup de
  /// instalar como app (ver InstallAppButton) — para de aparecer em qualquer
  /// janela/dispositivo mobile dele daí em diante.
  isMobileDownloaded Boolean @default(false) @map("is_mobile_downloaded")

  // Ids da tabela Group — sem FK explícita (array solto): remover um grupo já
  // limpa essa referência via DELETE cascade manual na rota, não via
  // constraint de banco.
  groups       String[]  @default([])
  lastActiveAt DateTime? @map("last_active_at")

  // participantVolumes/mutedParticipants são chaveados por id de participante
  // arbitrário (LiveKit identity) — sem normalizar em tabela filha por agora,
  // o único acesso necessário é ler/mesclar o blob inteiro (ver user/route.ts).
  channelPreferences Json? @map("channel_preferences")

  textMessages        TextMessage[]        @relation("TextMessageAuthor")
  textMessageMentions TextMessageMention[]

  @@map("users")
}

model Group {
  id        String @id @default(cuid())
  title     String
  textColor String @map("text_color")
  sortIndex Int    @map("sort_index")

  @@map("groups")
}

/// Código de convite que concede CANAL_ACCESS a quem resgata — criado por um
/// channels_admin em /admin/invites. Multi-uso e sem expiração por padrão: o
/// mesmo código serve pra vários convidados até alguém revogar (revokedAt).
model InviteCode {
  id            String    @id @default(cuid())
  code          String    @unique
  createdById   String?   @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  revokedAt     DateTime? @map("revoked_at")
  /// Contador simples, não uma tabela de resgates — não há necessidade de
  /// auditoria por usuário hoje, só de saber se o código está sendo usado.
  redeemedCount Int       @default(0) @map("redeemed_count")

  @@map("invite_codes")
}

/**
 * Linha única (id fixo em 1, ver SINGLETON_ID em lib/rtc/channelsConfig.ts) com
 * a configuração do OpenCall que o admin muda em runtime (kill switch e
 * qualidade de transmissão).
 * streamSettings é Json (não colunas) porque o shape é validado por
 * parseStreamSettings, que já é a fonte única de verdade do formato — espalhar
 * height/frameRate/bitrate/preset em colunas duplicaria essa validação no banco
 * sem ninguém nunca consultar por esses campos isoladamente.
 */
model ChannelsConfig {
  id             Int      @id @default(1)
  enabled        Boolean  @default(true)
  streamSettings Json     @map("stream_settings")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("channels_config")
}

/**
 * Alerta "fulano entrou no canal" postado no Discord — guardado pra não mandar
 * outro enquanto o anterior vale e pra saber qual mensagem apagar quando o
 * canal esvaziar. Precisa ser durável (não um Map em memória) porque o
 * processo pode reiniciar no meio da janela do TTL e a mensagem ficaria órfã
 * no Discord pra sempre.
 */
model VoiceChannelAlert {
  channelId        String   @id @map("channel_id")
  discordMessageId String   @map("discord_message_id")
  expiresAt        DateTime @map("expires_at")

  @@map("voice_channel_alerts")
}

model TextMessage {
  id        String  @id @default(cuid())
  channelId String  @map("channel_id")
  /// Cascade: excluir o canal (hard-delete, ver ADR-0003 revisada) apaga o
  /// histórico de mensagens junto — a rota de admin avisa a contagem antes.
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  authorId String @map("author_id")
  author   User   @relation("TextMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  /// Null quando a mensagem é só imagem. Ao menos um entre content e imageKey é
  /// obrigatório — invariante da rota de envio, não do banco (Postgres não
  /// expressa "um dos dois" sem CHECK, e o CHECK escaparia do schema Prisma).
  content String? @db.VarChar(2000)

  /// Chave do objeto no R2. Ganha o prefixo [deleted-in-chat]/ quando a
  /// mensagem é apagada (ver storage.ts) — a URL pública é derivada, nunca guardada.
  imageKey    String? @map("image_key")
  imageWidth  Int?    @map("image_width")
  imageHeight Int?    @map("image_height")
  imageBytes  Int?    @map("image_bytes")

  /// SetNull, não Cascade: apagar a mensagem citada não pode apagar quem citou.
  /// A UI cai pro estado "mensagem original indisponível".
  replyToId String?       @map("reply_to_id")
  replyTo   TextMessage?  @relation("TextMessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   TextMessage[] @relation("TextMessageReply")

  /// Quem foi @mencionado — tabela própria (não array escalar) pra dar pra
  /// incluir author/replyTo/mentions todos via um único `include` (ver
  /// MESSAGE_INCLUDE em dto.ts).
  mentions TextMessageMention[]

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  /// Suporta a query de listagem inteira (filtro por canal + ordenação do
  /// cursor keyset). deleted_at fica de fora de propósito: a seletividade dele
  /// é baixíssima (quase tudo é NULL) e ele só encarece a manutenção do índice.
  @@index([channelId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([replyToId])
  @@map("text_messages")
}

/// Linha por (mensagem, usuário mencionado) — quem foi @mencionado nela.
model TextMessageMention {
  messageId String      @map("message_id")
  message   TextMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
  @@map("text_message_mentions")
}

/// Estado de leitura por usuário e canal.
model TextChannelRead {
  userId    String  @map("user_id")
  channelId String  @map("channel_id")
  /// Cascade — mesmo motivo de TextMessage.channel.
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  lastReadMessageId String?  @map("last_read_message_id")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@id([userId, channelId])
  @@index([channelId])
  @@map("text_channel_reads")
}

/// Amostra horária de CPU/RAM/disco/rede da VPS do LiveKit (ver
/// infra/vps-metrics/collect-local.sh), postada via /api/admin/metrics/ingest.
/// Opcional: só populado se a instalação fizer self-host da VPS do LiveKit.
/// netRxBytes/netTxBytes já chegam como delta da hora (não cumulativo) — o
/// script mantém o estado cumulativo localmente pra sobreviver a reboot sem
/// estourar o número.
model ServerMetricSnapshot {
  id          String   @id @default(cuid())
  capturedAt  DateTime @map("captured_at")
  cpuPercent  Float    @map("cpu_percent")
  ramUsedMb   Int      @map("ram_used_mb")
  ramTotalMb  Int      @map("ram_total_mb")
  diskUsedGb  Float    @map("disk_used_gb")
  diskTotalGb Float    @map("disk_total_gb")
  netRxBytes  BigInt   @map("net_rx_bytes")
  netTxBytes  BigInt   @map("net_tx_bytes")

  @@index([capturedAt(sort: Desc)])
  @@map("server_metric_snapshots")
}

/// Bandwidth diário oficial da Vultr (GET /v2/instances/{id}/bandwidth), a
/// mesma fonte que a Vultr usa pra cobrar excedente — por isso vive separado
/// do snapshot horário local, que é só pra granularidade intradiária.
/// Opcional: só populado se a instalação fizer self-host na Vultr.
model ServerBandwidthDaily {
  date          DateTime @id @db.Date
  incomingBytes BigInt   @map("incoming_bytes")
  outgoingBytes BigInt   @map("outgoing_bytes")

  @@map("server_bandwidth_daily")
}

/// Linha única (id fixo em 1, mesmo padrão de ChannelsConfig) com os specs e
/// custo do plano Vultr atual, atualizada 1x/dia pelo mesmo script que manda
/// o bandwidth (collect-bandwidth.sh). Opcional: só populado em self-host.
model ServerPlanInfo {
  id               Int      @id @default(1)
  planId           String   @map("plan_id")
  region           String
  vcpuCount        Int      @map("vcpu_count")
  ramMb            Int      @map("ram_mb")
  diskGb           Int      @map("disk_gb")
  bandwidthQuotaGb Int      @map("bandwidth_quota_gb")
  monthlyCostUsd   Float    @map("monthly_cost_usd")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("server_plan_info")
}
