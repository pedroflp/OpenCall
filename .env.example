# Discord OAuth — o primeiro login (banco vazio) vira ADMIN automático.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Discord bot (opcional — alertas de canal)
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
DISCORD_CHAT_CHANNEL_ID=

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Postgres
DATABASE_URL=

# R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=

# Dashboard de infra (opcional, só self-host)
SERVER_METRICS_INGEST_SECRET=
VPS_SSH_HOST=
VPS_SSH_PORT=22
VPS_SSH_USER=
VPS_SSH_PRIVATE_KEY=

# Geral
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server Actions/Server Components chamam as próprias rotas de API por aqui
# (não tem window.location no server) — sempre igual à de cima.
NEXT_PUBLIC_apiBaseUrl=http://localhost:3000
# Trava de emergência do RTC pro deploy inteiro — omitida/qualquer valor
# diferente de false/0/off = habilitado (default). Ver docs/deploy/ENV_REFERENCE.md.
NEXT_PUBLIC_RTC_ENABLED=
# Commit deste deploy (opcional). Com ele, uma aba aberta durante um deploy novo
# recebe o aviso de "atualize a página"; sem ele, o aviso nunca aparece e nada
# mais muda. Variável de RUNTIME, não de build — no Railway já vem pronta como
# RAILWAY_GIT_COMMIT_SHA, e num deploy próprio basta passar o SHA no container.
APP_COMMIT_SHA=

# GIFs no chat (opcional). Sem a chave, o botão de GIF simplesmente não
# aparece — o chat funciona igual. Crie um app em developers.giphy.com e use
# a chave de API dele. Nunca vira NEXT_PUBLIC_: a busca passa pelo servidor
# (/api/chat/giphy) justamente pra chave não ir pro browser.
GIPHY_API_KEY=
