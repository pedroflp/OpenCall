# Valores já batem com docker-compose.yml — copie pra .env e preencha só o
# bloco do Discord (não dá pra containerizar OAuth, ver README). Tem que ser
# .env mesmo, não .env.local: a CLI do Prisma só lê .env.
#
#   cp .env.docker.example .env

# Discord OAuth — crie um app em https://discord.com/developers/applications,
# adicione o redirect http://localhost:3000/api/auth/callback/discord e cole
# as credenciais aqui. O primeiro login (banco vazio) vira ADMIN automático,
# então faça esse primeiro login com a sua própria conta do Discord.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
NEXTAUTH_SECRET=dev-secret-troque-em-producao
NEXTAUTH_URL=http://localhost:3000

# LiveKit (container `livekit` do docker-compose, --dev keys)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Postgres (container `postgres` do docker-compose)
DATABASE_URL=postgresql://opencall:opencall@localhost:5433/opencall

# R2 (container `minio` do docker-compose no lugar do R2 de verdade)
R2_ENDPOINT=http://localhost:9000
R2_ACCOUNT_ID=local
R2_ACCESS_KEY_ID=opencall
R2_SECRET_ACCESS_KEY=opencall123
R2_BUCKET=opencall
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=http://localhost:9000/opencall

# Dashboard de infra (opcional, só self-host — deixe vazio em dev)
SERVER_METRICS_INGEST_SECRET=
VPS_SSH_HOST=
VPS_SSH_PORT=22
VPS_SSH_USER=
VPS_SSH_PRIVATE_KEY=

# Geral
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Usada por Server Actions/Server Components pra chamar as próprias rotas de
# API do app (não tem window.location no server) — sempre igual à de cima.
NEXT_PUBLIC_apiBaseUrl=http://localhost:3000

# GIFs no chat (opcional). Sem a chave, o botão de GIF simplesmente não
# aparece — o chat funciona igual. Crie um app em developers.giphy.com e use
# a chave de API dele. Nunca vira NEXT_PUBLIC_: a busca passa pelo servidor
# (/api/chat/giphy) justamente pra chave não ir pro browser.
GIPHY_API_KEY=
